# PostgreSQL (для Docker Compose и production)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campus_one?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=campus_one

# Для локального запуска без Docker можно временно переключить schema.prisma на sqlite
# и использовать: DATABASE_URL="file:./dev.db"
